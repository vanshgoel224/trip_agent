# All keys are OPTIONAL. The code reads them from the process environment
# (os.environ) — there is no .env auto-loader, so export them in your shell:
#   export YOUTUBE_API_KEY=...        (bash / Termux)
#   $env:YOUTUBE_API_KEY = "..."      (PowerShell)

# discover.py — YouTube Data API v3 key from Google Cloud Console.
# Without it YouTube is skipped and only Reddit is fetched.
YOUTUBE_API_KEY=

# sync_online.py — OpenWeatherMap key for the 5-day forecast cache.
# Without it weather sync is skipped.
OPENWEATHER_API_KEY=

# sync_online.py — declared but not yet wired to any call
# (POIs currently come from the free, keyless Overpass API).
GOOGLE_PLACES_API_KEY=
