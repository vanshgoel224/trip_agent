# Biruni — server-side configuration. NEVER expose these to the frontend.
# Node does not auto-load .env: export them, or run `node --env-file=.env ...`.

# ---------- Models (spec §5) ----------
# Online: Nemotron Ultra on NVIDIA's hosted API. Setting the key is enough;
# base URL and model default to https://integrate.api.nvidia.com/v1 and
# nvidia/nemotron-3-ultra-550b-a55b. Get a key from build.nvidia.com.
ONLINE_MODEL_API_KEY=
ONLINE_MODEL_BASE_URL=
ONLINE_MODEL_NAME=
# Temporary stand-in until the NVIDIA key is in: Gemini via Google's
# OpenAI-compatible endpoint. Ignored when ONLINE_MODEL_API_KEY is set.
# GEMINI_MODEL is optional; without it a flash model is picked from your key's list.
GEMINI_API_KEY=
GEMINI_MODEL=
# Local tier. Unset = Hermes Agent gateway (see HERMES_* below). "off" disables it.
# Ollama: {"baseUrl":"http://localhost:11434/v1","model":"qwen3:4b"}
OFFLINE_MODEL_CONFIG=
# online (default): online model first, local as fallback. local: local first.
MODEL_PRIMARY=online
MODEL_TIMEOUT_MS=20000

# ---------- Database ----------
# Prototype uses node:sqlite at BIRUNI_DB_PATH. DATABASE_URL is for prisma/schema.prisma (Postgres).
BIRUNI_DB_PATH=biruni.db
DATABASE_URL=

# ---------- Cache ----------
# Reserved by the spec; the prototype does not use Redis yet.
REDIS_URL=

# ---------- Rails ----------
# auto (default) = each rail is live when its keys are set, simulated otherwise.
# mock = simulate everything (tests, scripted demo). live = force all live.
PROVIDER_MODE=auto

# Gnani (Vachana) voice: TTS + STT in 10 Indian languages. https://docs.gnani.ai
# Until set, the app uses the device's built-in voices (browser speech APIs).
GNANI_API_KEY=
GNANI_API_URL=https://api.vachana.ai

# Pine Labs Online (Plural). Sandbox: https://pluraluat.v2.pinepg.in  Prod: https://api.pluralpay.in
PINELABS_CLIENT_ID=
PINELABS_API_KEY=          # client secret
PINELABS_API_URL=

# Delhivery parcel/luggage booking. Without these, bookings are simulated (and labelled so).
DELHIVERY_API_KEY=
DELHIVERY_PICKUP_LOCATION=   # your registered warehouse/pickup location name in Delhivery One
DELHIVERY_API_URL=            # default https://track.delhivery.com (staging: https://staging-express.delhivery.com)
DELHIVERY_SIM_STAGE_MIN=3     # simulated tracking: minutes per stage

# Setu Account Aggregator (FIU). Sandbox: https://fiu-sandbox.setu.co
SETU_ACCESS_TOKEN=
SETU_PRODUCT_INSTANCE_ID=
SETU_API_URL=

# Zerodha Kite Connect (read-only holdings). Redirect URL in your Kite app: APP_BASE_URL/api/zerodha/callback
ZERODHA_API_KEY=
ZERODHA_API_SECRET=

# ---------- Negotiator: WhatsApp Business Cloud API (optional; "relay" works without it) ----------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_VERIFY_TOKEN=        # you choose; paste the same in Meta's webhook settings
WHATSAPP_APP_SECRET=          # required to accept inbound webhooks (signature check)
WHATSAPP_TEMPLATE=            # approved template for first contact (WhatsApp's 24 h rule)
WHATSAPP_TEMPLATE_LANG=en

# ---------- Connectors ----------
# Google Calendar: OAuth web client (Calendar API enabled), redirect URI APP_BASE_URL/api/calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# …or read-only: the calendar's "secret address in iCal format"
GOOGLE_CALENDAR_ICS_URL=
# Reddit "script" app (https://www.reddit.com/prefs/apps); anonymous access is often blocked
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# YouTube Data API v3 key (Google Cloud API key, starts AIza). A Gemini key will NOT work.
YOUTUBE_API_KEY=
# Splitwise personal API key (https://secure.splitwise.com/apps) to sync splits
SPLITWISE_API_KEY=
# External MCP servers configured server-side (stdio allowed only here), JSON array:
# [{"name":"weather","transport":"http","url":"https://…/mcp","headers":{"Authorization":"Bearer …"}},
#  {"name":"files","transport":"stdio","command":"npx","args":["-y","some-mcp-server"]}]
BIRUNI_MCP_SERVERS=
# OpenStreetMap services (defaults are the free public instances; respect their fair-use limits)
OSM_USER_AGENT=
NOMINATIM_URL=
OVERPASS_URL=
OSRM_URL=
# L4 autopilot and critical thinking
AUTOPILOT_TICK_MS=60000
AUTOPILOT_DELAY_RECOVER_MIN=180
AUTOPILOT_LEAVE_BUFFER_MIN=30
CRITIC=auto                   # auto | off  (self-check pass before replies with money/bookings/numbers)
AGENT_MAX_STEPS=12
PHOTON_URL=                   # typo-tolerant OSM geocoder, default https://photon.komoot.io
# Crash detection
IMPACT_G=3.5
CRASH_CHECKIN_MS=30000

# ---------- Security ----------
# PIN or password that unlocks the app and the encrypted data (4–12 digits, or 6+ char password).
# Used only on the first run (when no PIN exists yet); afterwards change it in the app.
BIRUNI_INITIAL_PIN=
LOCK_IDLE_MIN=30              # auto-lock after this many idle minutes

# ---------- Application ----------
APP_BASE_URL=http://localhost:8787
PORT=8787
# Also seeds the per-agent MCP service tokens. Change it outside local dev.
JWT_SECRET=
UNDO_WINDOW_MS=30000
CRITICAL_BATTERY_PCT=5

# ---------- apps/phone-offline (Python, optional) ----------
YOUTUBE_API_KEY=
OPENWEATHER_API_KEY=
GOOGLE_PLACES_API_KEY=

# ---- Local model: Hermes Agent (tools off) ----
# Default local tier. Start Hermes with config/hermes/config.yaml, then:
# HERMES_URL=http://127.0.0.1:8642/v1
# HERMES_API_KEY=            # API_SERVER_KEY from ~/.hermes/.env
# HERMES_MODEL=hermes-agent  # verify the model id your gateway reports at /v1/models
# Use Ollama instead: OFFLINE_MODEL_CONFIG={"baseUrl":"http://localhost:11434/v1","model":"qwen3:4b"}

# ---- Anthropic (optional server default; users can also add keys in the app) ----
# ANTHROPIC_EFFORT=medium

# ---- Remote MCP at /mcp (off unless set; 24+ random chars) ----
# BIRUNI_MCP_TOKEN=
