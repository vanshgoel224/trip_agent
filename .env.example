# Biruni — server-side configuration. NEVER expose these to the frontend.
# Node does not auto-load .env: export them, or run `node --env-file=.env ...`.

# ---------- Models (spec §5) ----------
# Online (Nemotron Ultra) via any OpenAI-compatible /chat/completions endpoint.
# Verify the exact base URL and model id in your provider's current docs.
ONLINE_MODEL_API_KEY=
ONLINE_MODEL_BASE_URL=
ONLINE_MODEL_NAME=
# Offline (Qwen 4B on the phone), JSON. Example for an Ollama OpenAI-compatible server:
# OFFLINE_MODEL_CONFIG={"baseUrl":"http://localhost:11434/v1","model":"<your qwen tag>"}
OFFLINE_MODEL_CONFIG=
MODEL_TIMEOUT_MS=4000

# ---------- Database ----------
# Prototype uses node:sqlite at BIRUNI_DB_PATH. DATABASE_URL is for prisma/schema.prisma (Postgres).
BIRUNI_DB_PATH=biruni.db
DATABASE_URL=

# ---------- Cache ----------
# Reserved by the spec; the prototype does not use Redis yet.
REDIS_URL=

# ---------- Rails ----------
# mock = realistic simulator (default). live = real adapters (NOT implemented yet).
PROVIDER_MODE=mock

GNANI_API_KEY=
GNANI_API_URL=

PINELABS_API_KEY=
PINELABS_CLIENT_ID=
PINELABS_API_URL=

DELHIVERY_API_KEY=
DELHIVERY_API_URL=

SETU_API_KEY=
SETU_API_URL=

ZERODHA_API_KEY=
ZERODHA_API_SECRET=

# ---------- Application ----------
APP_BASE_URL=http://localhost:8787
PORT=8787
# Also seeds the per-agent MCP service tokens. Change it outside local dev.
JWT_SECRET=
UNDO_WINDOW_MS=30000
CRITICAL_BATTERY_PCT=5

# ---------- apps/phone-offline (Python, optional) ----------
YOUTUBE_API_KEY=
OPENWEATHER_API_KEY=
GOOGLE_PLACES_API_KEY=
