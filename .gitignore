# ---- Node ----
node_modules/
*.tsbuildinfo
dist/
coverage/
*.log
npm-debug.log*
biruni.db
biruni.db-*

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/

# ---- Secrets ----
.env
.env.*
!.env.example

# ---- Local trip state (SQLite) — phone-specific, never commit ----
trip.db
trip.db-journal
trip.db-wal
trip.db-shm

# ---- Offline cache — regenerated by sync_online.py, may hold API responses ----
**/cached_data/*.json
!**/cached_data/.gitkeep

# ---- graphify — machine-local bits (graph.html / graph.json / GRAPH_REPORT.md are committed) ----
graphify-out/cache/
graphify-out/.graphify_python
graphify-out/.graphify_root

# ---- OS / editor ----
.DS_Store
Thumbs.db
.vscode/
.idea/

# ---- Exported memory (plaintext copy of the encrypted graph) ----
memory-out/

# ---- Multi-user data (encrypted per user) ----
data/
